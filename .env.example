# Copy to .env and edit. Never commit .env.
# All values are optional; defaults live in config.py.

# Local embedding model (CPU by default)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Vector store
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=bis_documents

# Chunking (characters)
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval
TOP_K=5

# Local LLM through Ollama. No API key is needed.
LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120
# Reasoning before answering: slower, sometimes more careful. See config.py.
OLLAMA_THINK=false

# Speech-to-text (Sarvam AI cloud API). Needed only for voice questions.
# Put your own key in .env. Never commit it.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
# translate = English text from any supported Indian language; transcribe = text in the spoken language
SARVAM_STT_MODE=translate
# Kannada and Hindi answers: generated in English, then translated with this Sarvam model
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1

# FastAPI backend: browser origins allowed by CORS (comma-separated)
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Evidence gate: questions below these limits are refused, not answered.
# See config.py for how the defaults were chosen.
MIN_VECTOR_SCORE=0.40
MIN_KEYWORD_OVERLAP=0.5
